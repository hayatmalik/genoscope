{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:api": "cd .. && PYTHONPATH=backend uv run --no-sync python -c 'import json; from app.main import app; print(json.dumps(app.openapi()))' > frontend/openapi.json && cd frontend && openapi-typescript openapi.json -o src/api/schema.ts && rm openapi.json"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/plots": "^2.6.8",
    "@tanstack/react-query": "^5.104.2",
    "antd": "^6.6.6",
    "axios": "^1.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
